[Unit]
Description=OpenTradeNet Hyperliquid Price Monitor Bot
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=solana
WorkingDirectory=/home/solana/opentradenet_bot
ExecStart=/usr/bin/python3 /home/solana/opentradenet_bot/hyperliquid_bot.py opentradenet.env
Restart=on-failure
RestartSec=10
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
